---
import SocialIcon from './components/social-icons.astro';
import PoweredBy from './components/PoweredBy.astro';
import { basePath, withBase } from '../../utils/withBase';

const { footerConfig, brandingConfig } = Astro.props;
type FooterMenuItem = { label: string; href: string };
type FooterContent = {
  theme?: { mode?: 'dark' | 'light'; background?: string; text?: string; accent?: string };
  brand?: { name?: string; description?: string };
  contact?: { address?: string; email?: string; phone?: string };
  menu?: FooterMenuItem[];
  social?: Record<string, string>;
  legal?: {
    privacyPath?: string;
    termsPath?: string;
    cookiePath?: string;
    poweredBy?: {
      enabled?: boolean;
      label?: string;
      name?: string;
      url?: string;
      logo?: string;
      logoAlt?: string;
    };
  };
  poweredBy?: boolean;
  systemStatus?: boolean;
  trustBadge?: string;
};

const footer = (footerConfig?.footer ?? {}) as FooterContent;

const currentYear = new Date().getFullYear();
const normalizedBase = basePath;

const footerBg = footer?.theme?.background || 'var(--component-footer-background)';
const footerText = footer?.theme?.text || 'var(--component-footer-text)';
const footerAccent = footer?.theme?.accent || 'var(--component-footer-accent)';
const footerBorder = 'var(--component-footer-border)';
const footerIconSurface = 'var(--component-footer-icon-surface)';

const brandName = footer?.brand?.name || '';
const brandDescription = footer?.brand?.description || '';
const contactAddress = footer?.contact?.address || '';
const contactEmail = footer?.contact?.email || '';
const contactPhone = footer?.contact?.phone || '';
const menuItems: FooterMenuItem[] = Array.isArray(footer?.menu)
  ? footer.menu.filter((item): item is FooterMenuItem => Boolean(item?.label && item?.href))
  : [];

const socialEntries: Array<[string, string]> = Object.entries(footer?.social || {}).filter(
  (entry): entry is [string, string] => typeof entry[1] === 'string' && entry[1].trim() !== ''
);

const showSystemStatus = Boolean(footer?.systemStatus);
const trustBadge = footer?.trustBadge || '';

const mergedLegal = {
  privacyPath: footer?.legal?.privacyPath || '',
  termsPath: footer?.legal?.termsPath || '',
  cookiePath: footer?.legal?.cookiePath || '',
  poweredBy: {
    ...footer?.legal?.poweredBy,
  },
};

const legalLinks = [
  { label: 'Adatvedelem', href: mergedLegal.privacyPath },
  { label: 'ASZF', href: mergedLegal.termsPath },
  { label: 'Cookie', href: mergedLegal.cookiePath },
].filter((item) => item.href);

const poweredByData = {
  label: mergedLegal?.poweredBy?.label || mergedLegal?.poweredBy?.name || '',
  url: mergedLegal?.poweredBy?.url || '',
  logo: mergedLegal?.poweredBy?.logo || '',
  logoAlt: mergedLegal?.poweredBy?.logoAlt || mergedLegal?.poweredBy?.name || 'Powered by',
};

const showPoweredBy = Boolean(
  (brandingConfig?.show_powered_by ?? true) &&
  footer?.poweredBy &&
  mergedLegal?.poweredBy?.enabled !== false &&
  poweredByData.label &&
  poweredByData.url
);
---

<footer
  style={`
    --footer-bg:${footerBg};
    --footer-text:${footerText};
    --footer-accent:${footerAccent};
    --footer-border:${footerBorder};
    --footer-icon-surface:${footerIconSurface};
    border-color:var(--footer-border);
  `}
  class="w-full border-t"
>
  <div class="w-full" style="background:var(--footer-bg); color:var(--footer-text);">
    <div class="mx-auto px-6 py-14 md:py-16" style="max-width:var(--layout-container-max);">
      <div class="grid grid-cols-1 gap-12 md:grid-cols-3">
        <div>
          {brandName && (
            <a href={normalizedBase} class="block text-xl font-semibold tracking-tight">
              {brandName}
            </a>
          )}
          {brandDescription && (
            <p class="mt-4 max-w-sm text-sm leading-6 opacity-75">
              {brandDescription}
            </p>
          )}

          {socialEntries.length > 0 && (
            <div class="mt-6 flex flex-wrap items-center gap-3">
              {socialEntries.map(([platform, url]) => (
                <a
                  href={url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={platform}
                  class="inline-flex h-9 w-9 items-center justify-center rounded-md border transition hover:scale-105"
                  style="border-color:var(--footer-border); color:var(--footer-text); background:var(--footer-icon-surface);"
                >
                  <SocialIcon name={platform} />
                </a>
              ))}
            </div>
          )}
        </div>

        <nav aria-label="Footer menu">
          <h4 class="text-xs font-semibold uppercase tracking-wider opacity-70">Menu</h4>
          {menuItems.length > 0 && (
            <ul class="mt-4 space-y-2 text-sm">
              {menuItems.map((item: FooterMenuItem) => (
                <li>
                  <a href={withBase(item.href)} class="opacity-75 transition hover:opacity-100 hover:text-[var(--footer-accent)]">
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </nav>

        <address class="not-italic text-sm">
          <h4 class="text-xs font-semibold uppercase tracking-wider opacity-70">Contact</h4>
          <ul class="mt-4 space-y-3 opacity-80">
            {contactAddress && <li>{contactAddress}</li>}
            {contactEmail && (
              <li>
                <a href={`mailto:${contactEmail}`} class="transition hover:opacity-100 hover:text-[var(--footer-accent)]">
                  {contactEmail}
                </a>
              </li>
            )}
            {contactPhone && (
              <li>
                <a href={`tel:${contactPhone}`} class="transition hover:opacity-100 hover:text-[var(--footer-accent)]">
                  {contactPhone}
                </a>
              </li>
            )}
          </ul>
        </address>
      </div>

      <div class="mt-10 border-t pt-6" style="border-color:var(--footer-border);">
        <div class="flex flex-col items-center gap-4 text-xs md:text-sm">
          {showSystemStatus && (
            <div class="flex items-center gap-2 opacity-75">
              <span class="h-2 w-2 rounded-full" style="background:var(--footer-accent);"></span>
              <span>System online</span>
            </div>
          )}

          {trustBadge && (
            <p class="text-center opacity-65">{trustBadge}</p>
          )}

          {legalLinks.length > 0 && (
            <nav aria-label="Legal links" class="flex flex-wrap items-center justify-center gap-6 opacity-70">
              {legalLinks.map((item) => (
                <a href={withBase(item.href)} class="transition hover:opacity-100 hover:text-[var(--footer-accent)]">
                  {item.label}
                </a>
              ))}
            </nav>
          )}

          <p class="text-center opacity-60">&copy; {currentYear} {brandName}</p>

          {showPoweredBy && (
            <div class="opacity-60 hover:opacity-100 transition">
              <PoweredBy data={poweredByData} />
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</footer>


