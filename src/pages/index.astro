<script>
  const siteHeader = document.getElementById('site-header');
  const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  if (siteHeader && mobileMenuToggle && mobileMenu) {
    let lastScrollY = window.scrollY;

    const applyHeaderState = () => {
      const isMobile = window.innerWidth < 768;
      const isOpen = !mobileMenu.classList.contains('hidden');

      if (!isMobile) {
        siteHeader.classList.remove('nav-hidden');
        siteHeader.classList.add('nav-visible');
        return;
      }

      if (isOpen) {
        siteHeader.classList.remove('nav-hidden');
        siteHeader.classList.add('nav-visible');
        lastScrollY = window.scrollY;
        return;
      }

      if (window.scrollY > lastScrollY && window.scrollY > 24) {
        siteHeader.classList.add('nav-hidden');
        siteHeader.classList.remove('nav-visible');
      } else {
        siteHeader.classList.remove('nav-hidden');
        siteHeader.classList.add('nav-visible');
      }

      lastScrollY = window.scrollY;
    };

    const lines = mobileMenuToggle.querySelectorAll('.mobile-menu-icon-line');

    const updateMenuIcon = () => {
      const isOpen = !mobileMenu.classList.contains('hidden');
      lines.forEach((line) => line.classList.toggle('open', isOpen));
      mobileMenuToggle.setAttribute('aria-expanded', String(isOpen));
    };

    const toggleMenu = () => {
      mobileMenu.classList.toggle('hidden');
      updateMenuIcon();
      applyHeaderState();
    };

    mobileMenuToggle.addEventListener('click', toggleMenu);
    mobileLinks.forEach((link) => link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      updateMenuIcon();
    }));

    window.addEventListener('scroll', applyHeaderState, { passive: true });
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768) {
        mobileMenu.classList.add('hidden');
        updateMenuIcon();
      }
      applyHeaderState();
    });

    updateMenuIcon();
    applyHeaderState();
  }

  const billingToggle = document.getElementById('billing-toggle') as HTMLInputElement | null;
  const billingAddress = document.getElementById('billing-address');

  const setFieldState = (field, isValid, message = 'Kötelező és helyes adat szükséges') => {
    if (!field) return;

    field.setAttribute('aria-invalid', String(!isValid));
    field.setCustomValidity(isValid ? '' : message);
    field.classList.toggle('border-red-500', !isValid);
    field.classList.toggle('bg-red-950/20', !isValid);
    field.classList.toggle('text-red-100', !isValid);
    field.classList.toggle('focus:border-red-400', !isValid);
  };

  if (billingToggle && billingAddress) {
    const syncBillingState = () => {
      billingAddress.classList.toggle('hidden', !billingToggle.checked);
      if (billingToggle.checked) {
        validateBillingFields();
      } else {
        ['billing-city', 'billing-zip', 'billing-address-line'].forEach((id) => {
          const field = document.getElementById(id);
          if (field) {
            setFieldState(field, true, '');
          }
        });
      }
    };

    billingToggle.addEventListener('change', syncBillingState);
    syncBillingState();
  }

  const checkoutForm = document.getElementById('checkout-form') as HTMLFormElement | null;
  const checkoutBaseStep = document.getElementById('checkout-base-step');
  const checkoutSummaryStep = document.getElementById('checkout-summary-step');
  const toSummaryButton = document.getElementById('to-summary-button');
  const backToBaseButton = document.getElementById('back-to-base-button');
  const productCodeInput = document.getElementById('product-code-input');
  const productCodeList = document.getElementById('product-code-list');
  const summaryBaseData = document.getElementById('summary-base-data');
  const summaryProductList = document.getElementById('summary-product-list');
  const orderConfirmation = document.getElementById('order-confirmation') as HTMLInputElement | null;

  const productCodes: { id: string; code: string }[] = [];
  const PRODUCT_CODE_PATTERN = /^[A-Z0-9-]{3,20}$/;

  const validateProductCodeInput = (field) => {
    if (!field) return true;

    const value = field.value.trim();
    const duplicate = productCodes.some((item) => item.code === value.toUpperCase());

    if (!value) {
      setFieldState(field, false, 'Add meg a termékkódot.');
      return false;
    }

    if (!PRODUCT_CODE_PATTERN.test(value.toUpperCase())) {
      setFieldState(field, false, 'A kód csak nagybetűt, számot és kötőjelet tartalmazhat.');
      return false;
    }

    if (duplicate) {
      setFieldState(field, false, 'Ez a termékkód már hozzá lett adva.');
      return false;
    }

    setFieldState(field, true, '');
    return true;
  };

  const validateCustomField = (field) => {
    if (!field) return true;

    const value = field.value.trim();

    if (field.id === 'customer-name') {
      const isValid = value.length >= 2;
      setFieldState(field, isValid, 'A név legalább 2 karakter hosszú kell legyen.');
      return isValid;
    }

    if (field.id === 'customer-phone') {
      const isValid = /^[+()0-9\s-]{7,}$/.test(value);
      setFieldState(field, isValid, 'Adj meg érvényes telefonszámot.');
      return isValid;
    }

    if (field.id === 'customer-email') {
      const isValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
      setFieldState(field, isValid, 'Adj meg érvényes e-mail címet.');
      return isValid;
    }

    if (field.id === 'shipping-city' || field.id === 'billing-city') {
      const isValid = value.length >= 2;
      setFieldState(field, isValid, 'A város mező kitöltése kötelező.');
      return isValid;
    }

    if (field.id === 'shipping-zip' || field.id === 'billing-zip') {
      const isValid = /^\d{4,5}$/.test(value);
      setFieldState(field, isValid, 'Az irányítószám 4 vagy 5 számjegyből áll.');
      return isValid;
    }

    if (field.id === 'shipping-address' || field.id === 'billing-address-line') {
      const isValid = value.length >= 5;
      setFieldState(field, isValid, 'A cím mező nem lehet üres.');
      return isValid;
    }

    const isValid = value.length > 0 && field.checkValidity();
    setFieldState(field, isValid, 'Kötelező és helyes adat szükséges');
    return isValid;
  };

  const renderProductCodes = () => {
    if (!productCodeList) return;

    if (!productCodes.length) {
      productCodeList.innerHTML = '<div class="rounded-2xl border border-dashed border-white/10 bg-slate-900/60 p-4 text-sm text-slate-400">Még nincs termékkód hozzáadva.</div>';
      return;
    }

    productCodeList.innerHTML = productCodes.map((item) => `
      <div class="flex items-center justify-between gap-3 rounded-2xl border border-white/10 bg-slate-900/80 p-3">
        <div class="flex items-center gap-2">
          <span class="rounded-full bg-orange-500/15 px-2.5 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-orange-300">Kód</span>
          <span class="text-sm font-medium text-white">${item.code}</span>
        </div>

        <button type="button" data-remove-code="${item.id}" class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold text-slate-200 transition hover:bg-white/10">
          Törlés
        </button>
      </div>
    `).join('');
  };

  const addProductCode = () => {
    if (!productCodeInput) return;

    const rawCode = productCodeInput.value.trim();
    const normalizedCode = rawCode.toUpperCase();

    if (!validateProductCodeInput(productCodeInput)) {
      productCodeInput.focus();
      productCodeInput.reportValidity();
      return;
    }

    productCodes.push({
      id: `code-${Date.now()}-${Math.random().toString(16).slice(2, 6)}`,
      code: normalizedCode,
    });

    setFieldState(productCodeInput, true, '');
    productCodeInput.value = '';
    productCodeInput.setCustomValidity('');
    renderProductCodes();
  };

  const validateBillingFields = () => {
    if (!billingToggle || !billingToggle.checked) {
      ['billing-city', 'billing-zip', 'billing-address-line'].forEach((id) => {
        const field = document.getElementById(id);
        if (field) {
          setFieldState(field, true, '');
        }
      });
      return true;
    }

    const billingFields = ['billing-city', 'billing-zip', 'billing-address-line']
      .map((id) => document.getElementById(id))
      .filter(Boolean);

    const valid = billingFields.every((field) => validateCustomField(field));
    if (!valid) {
      const firstInvalid = billingFields.find((field) => !field.checkValidity() || field.value.trim().length === 0);
      firstInvalid?.focus();
      firstInvalid?.reportValidity();
    }
    return valid;
  };

  const validateBaseStep = () => {
    const requiredFields = Array.from(document.querySelectorAll('.base-required'));
    const firstInvalid = [];
    let hasError = false;

    requiredFields.forEach((field) => {
      const isValid = validateCustomField(field);
      if (!isValid) {
        hasError = true;
        firstInvalid.push(field);
      }
    });

    if (!productCodes.length) {
      hasError = true;
      if (productCodeInput) {
        setFieldState(productCodeInput, false, 'Adj meg legalább egy termékkódot.');
        productCodeInput.reportValidity();
      }
    } else {
      if (productCodeInput) {
        setFieldState(productCodeInput, true, '');
      }
    }

    if (billingToggle && billingToggle.checked && !validateBillingFields()) {
      hasError = true;
    }

    if (hasError) {
      const target = firstInvalid[0] || productCodeInput || document.getElementById('billing-city');
      target?.focus();
      target?.reportValidity();
      return false;
    }

    return true;
  };

  const populateSummary = () => {
    if (!summaryBaseData || !summaryProductList) return;

    const name = document.getElementById('customer-name')?.value?.trim() || 'Nincs megadva';
