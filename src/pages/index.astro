        <div class="mt-1 text-base text-white">${name}</div>
      </div>
      <div>
        <div class="text-[11px] uppercase tracking-[0.18em] text-slate-400">Telefonszám</div>
        <div class="mt-1 text-base text-white">${phone}</div>
      </div>
      <div>
        <div class="text-[11px] uppercase tracking-[0.18em] text-slate-400">E-mail</div>
        <div class="mt-1 text-base text-white">${email}</div>
      </div>
      <div>
        <div class="text-[11px] uppercase tracking-[0.18em] text-slate-400">Szállítási cím</div>
        <div class="mt-1 text-base text-white">${shippingCity}, ${shippingZip}, ${shippingAddress}</div>
      </div>
      ${billingToggle && billingToggle.checked && billingCity && billingZip && billingAddressLine ? `
