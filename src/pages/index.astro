        <div class="legal-block">
          <h4>4. Adattovábbítás</h4>
          <p>A rendelés teljesítéséhez szükséges mértékben a személyes adatokat továbbíthatjuk a szállítási, tárhelyszolgáltatási és webshop üzemeltetési szolgáltatók részére.</p>
        </div>
        <div class="legal-block">
          <h4>5. Az adatok megőrzése</h4>
          <p>A személyes adatokat csak addig őrizzük meg, amíg az adatkezelés céljának teljesítéséhez szükséges, illetve ameddig azt jogszabály előírja vagy lehetővé teszi.</p>
        </div>
        <div class="legal-block">
          <h4>6. Az érintettek jogai</h4>
          <p>A vásárló jogosult hozzáférni személyes adataihoz, kérni azok helyesbítését, korlátozását vagy törlését, továbbá adatkezelés elleni tiltakozásra, amennyiben annak jogszabályi feltételei fennállnak. Kérdéseivel az e-mailen keresztül fordulhat hozzánk: koveskristof510@gmail.com.</p>
        </div>
        <div class="legal-block">
          <h4>7. Panasz benyújtása</h4>
          <p>Amennyiben úgy ítéli meg, hogy személyes adatainak kezelése nem felel meg a vonatkozó szabályoknak, panaszt tehet a Nemzeti Adatvédelmi és Információszabadság Hatóságnál (NAIH).</p>
        </div>
      `
    },
    'size-guide': {
      title: 'Mérettáblázat',
      content: `
        <div class="size-guide-wrap">
          <div class="size-guide-table-wrapper">
            <table class="size-guide-table">
              <thead>
                <tr>
                  <th>EU</th>
                  <th>US</th>
                  <th>US women's</th>
                  <th>BTH cm</th>
                </tr>
              </thead>
              <tbody>
                ${sizeGuideRows.map((row) => `<tr><td>${row[0]}</td><td>${row[1]}</td><td>${row[2]}</td><td>${row[3]}</td></tr>`).join('')}
              </tbody>
            </table>
          </div>
        </div>
      `
    }
  };

  const openModal = (key) => {
    const config = modalMap[key];
    if (!config || !legalModalOverlay || !legalModalContent || !legalModalTitle) return;

    legalModalTitle.textContent = config.title;
    legalModalContent.innerHTML = config.content;
    legalModalOverlay.classList.remove('hidden');
    legalModalOverlay.setAttribute('aria-hidden', 'false');
    document.body.classList.add('modal-open');
  };

  document.querySelectorAll('[data-modal-open]').forEach((button) => {
    button.addEventListener('click', () => openModal(button.dataset.modalOpen));
  });

  if (legalModalOverlay) {
    legalModalOverlay.addEventListener('click', (event) => {
      if (event.target === legalModalOverlay) {
        closeModal();
      }
    });
  }

  document.querySelectorAll('[data-close-modal]').forEach((button) => {
    button.addEventListener('click', closeModal);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && legalModalOverlay && !legalModalOverlay.classList.contains('hidden')) {
      closeModal();
    }
  });

  if (checkoutForm) {
    const checkoutFormStatus = document.getElementById('checkout-form-status') as HTMLParagraphElement | null;
    const checkoutSubmitButton = checkoutForm.querySelector('button[type="submit"]') as HTMLButtonElement | null;

    checkoutForm.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!validateBaseStep()) return;
      if (!orderConfirmation || !orderConfirmation.checked) {
        orderConfirmation?.setCustomValidity('Fogadd el az adatmezőket és a rendelés elfogadását.');
        orderConfirmation?.reportValidity();
        return;
      }

      orderConfirmation.setCustomValidity('');
      if (!checkoutSubmitButton || !checkoutFormStatus) return;

      checkoutSubmitButton.disabled = true;
      checkoutSubmitButton.textContent = 'Küldés...';
      checkoutFormStatus.textContent = '';

      const formData = new FormData(checkoutForm);
      formData.set('product_codes', productCodes.map((item) => item.code).join(', '));
      formData.set('payment_method', formData.get('paymentMethod') === 'bank' ? 'Előre utalás' : 'Utánvét');
      formData.delete('paymentMethod');

      if (!billingToggle?.checked) {
        ['billing_city', 'billing_postal_code', 'billing_address'].forEach((field) => formData.delete(field));
      }

      let orderSubmitted = false;

      try {
        const response = await fetch(checkoutForm.action, {
          method: 'POST',
          body: formData,
          headers: { Accept: 'application/json' },
        });

        if (!response.ok) {
          throw new Error('Order submission failed');
        }

        orderSubmitted = true;
        checkoutFormStatus.textContent = 'Köszönjük, a rendelésedet elküldtük.';
      } catch {
        checkoutFormStatus.textContent = 'A rendelés küldése nem sikerült. Kérjük, próbáld újra.';
      } finally {
        checkoutSubmitButton.disabled = orderSubmitted;
        checkoutSubmitButton.textContent = orderSubmitted ? 'Rendelés elküldve' : 'Megrendelés elküldése';
      }
    });
  }

  const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
  const contactFormStatus = document.getElementById('contact-form-status') as HTMLParagraphElement | null;

  if (contactForm && contactFormStatus) {
    const contactSubmitButton = contactForm.querySelector('button[type="submit"]') as HTMLButtonElement | null;

    contactForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!contactSubmitButton) return;

      contactSubmitButton.disabled = true;
      contactSubmitButton.textContent = 'Küldés...';
      contactFormStatus.textContent = '';

      try {
        const response = await fetch(contactForm.action, {
          method: 'POST',
          body: new FormData(contactForm),
          headers: { Accept: 'application/json' },
        });

        if (!response.ok) {
          throw new Error('Form submission failed');
        }

        contactForm.reset();
        contactFormStatus.textContent = 'Köszönjük, az üzenetedet elküldtük.';
      } catch {
        contactFormStatus.textContent = 'Az üzenet küldése nem sikerült. Kérjük, próbáld újra.';
      } finally {
        contactSubmitButton.disabled = false;
        contactSubmitButton.textContent = 'Küldés';
      }
    });
  }

  renderProductCodes();
</script>
