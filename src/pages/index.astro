          <div class="text-[11px] uppercase tracking-[0.18em] text-slate-400">Számlázási cím</div>
          <div class="mt-1 text-base text-white">${billingCity}, ${billingZip}, ${billingAddressLine}</div>
        </div>
      ` : ''}
    `;

    summaryProductList.innerHTML = productCodes.map((item) => `
      <div class="rounded-2xl border border-white/10 bg-slate-900/80 p-3">
        <div class="flex items-center justify-between gap-3">
          <span class="font-medium text-white">${item.code}</span>
        </div>
      </div>
    `).join('');
  };

  const setCheckoutStep = (isSummaryStep) => {
    if (checkoutBaseStep) {
      checkoutBaseStep.classList.toggle('hidden', isSummaryStep);
    }
    if (checkoutSummaryStep) {
      checkoutSummaryStep.classList.toggle('hidden', !isSummaryStep);
    }
  };

  if (productCodeInput && productCodeList) {
    productCodeInput.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') {
        event.preventDefault();
        addProductCode();
      }
    });

    productCodeInput.addEventListener('input', () => {
      if (productCodeInput.value.trim()) {
        validateProductCodeInput(productCodeInput);
      } else {
        setFieldState(productCodeInput, true, '');
      }
    });

    productCodeInput.addEventListener('blur', () => {
      if (productCodeInput.value.trim()) {
        validateProductCodeInput(productCodeInput);
      }
    });
  }

  document.querySelectorAll('.base-required, #billing-city, #billing-zip, #billing-address-line').forEach((field) => {
    field.addEventListener('input', () => validateCustomField(field));
    field.addEventListener('blur', () => validateCustomField(field));
  });

  if (document.getElementById('add-product-code')) {
    document.getElementById('add-product-code').addEventListener('click', addProductCode);
  }

  if (productCodeList) {
    productCodeList.addEventListener('click', (event) => {
      const button = event.target.closest('[data-remove-code]');
      if (!button) return;

      const itemId = button.getAttribute('data-remove-code');
      const itemIndex = productCodes.findIndex((item) => item.id === itemId);
      if (itemIndex >= 0) {
        productCodes.splice(itemIndex, 1);
      }
      renderProductCodes();
    });
  }

  if (toSummaryButton) {
    toSummaryButton.addEventListener('click', () => {
      if (!validateBaseStep()) return;
      populateSummary();
      setCheckoutStep(true);
    });
  }

  if (backToBaseButton) {
    backToBaseButton.addEventListener('click', () => setCheckoutStep(false));
  }

