---
import Layout from '../layouts/Layout.astro';

const navItems = [
  { label: 'Rendelés menete', href: '#rendeles-menete' },
  { label: 'Rólunk', href: '/rolunk' },
  { label: 'Kapcsolatfelvétel', href: '#kapcsolat' },
];

const metrics = [
  { value: '3.2k+', label: 'boldog ügyfél' },
  { value: '120+', label: 'termék' },
  { value: '4.9/5', label: 'értékelés' },
];
---

<Layout title="KAfit Store" description="Fitness és wellness termékek, sporteszközök és személyre szabott támogatás." lang="hu">
  <header id="site-header" class="sticky top-0 z-50 border-b border-white/10 bg-black/80 backdrop-blur-md transition-transform duration-300">
    <nav class="mx-auto flex max-w-[1500px] items-center gap-3 px-4 py-3 md:px-8 lg:px-12">
      <a href="/" class="flex items-center text-white" aria-label="KAfit Store kezdőlap">
        <img src="/kafit-store-logo.webp" width="2172" height="724" alt="KAfit Store" class="h-7 w-auto object-contain md:h-12 lg:h-16" />
      </a>

      <div class="hidden items-center gap-8 text-sm text-slate-300 md:flex md:flex-1 md:justify-center">
        {navItems.map((item) => (
          <a href={item.href} class="transition hover:text-white">{item.label}</a>
        ))}
      </div>

      <div class="flex flex-1 justify-center md:hidden">
        <a href="#vasarlas" class="nav-cta-2026 inline-flex px-4 py-2.5 text-sm font-semibold text-white">
          Vásárlás
        </a>
      </div>

      <div class="ml-auto flex items-center gap-2 md:gap-3">
        <a href="#vasarlas" class="nav-cta-2026 hidden px-4 py-2.5 text-sm font-semibold text-white md:inline-flex">
          Vásárlás
        </a>

        <button
          id="mobile-menu-toggle"
          type="button"
          aria-label="Menü"
          aria-expanded="false"
          class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/10 bg-white/5 text-white transition hover:bg-white/10 md:hidden"
        >
          <span class="flex flex-col gap-1.5">
            <span class="mobile-menu-icon-line block h-0.5 w-5 rounded-full bg-white"></span>
            <span class="mobile-menu-icon-line block h-0.5 w-5 rounded-full bg-white"></span>
            <span class="mobile-menu-icon-line block h-0.5 w-5 rounded-full bg-white"></span>
          </span>
        </button>
      </div>
    </nav>

    <div id="mobile-menu" class="hidden border-t border-white/10 bg-black/95 md:hidden">
      <div class="mx-auto flex max-w-[1500px] flex-col px-4 py-4">
        {navItems.map((item) => (
          <a href={item.href} class="mobile-nav-link border-b border-white/5 py-3 text-base text-slate-200 last:border-b-0 hover:text-white">{item.label}</a>
        ))}
      </div>
    </div>
  </header>

  <main>
    <section class="relative isolate mx-auto flex min-h-[100vh] w-full max-w-[1500px] items-center justify-center overflow-hidden px-4 pb-10 pt-16 md:px-8 md:pb-14 md:pt-20 lg:px-12">
      <div class="absolute inset-0 -z-10 overflow-hidden bg-black">
        <div class="absolute inset-0 flex items-stretch">
          <div class="hidden h-full w-[22.5%] overflow-hidden md:block">
            <video
              class="pointer-events-none h-full w-[150%] scale-[1.6] object-cover opacity-55 blur-[1px]"
              src="/Hero.video.mp4"
              autoplay
              muted
              loop
              playsinline
              poster="/kafit-store-logo.webp"
            ></video>
          </div>

          <div class="relative h-full flex-1 overflow-hidden">
            <video
              class="absolute inset-0 h-full w-full object-cover"
              src="/Hero.video.mp4"
              autoplay
              muted
              loop
              playsinline
              poster="/kafit-store-logo.webp"
            ></video>
          </div>

          <div class="hidden h-full w-[22.5%] overflow-hidden md:block">
            <video
              class="pointer-events-none h-full w-[150%] scale-[1.6] object-cover opacity-55 blur-[1px]"
              src="/Hero.video.mp4"
              autoplay
              muted
              loop
              playsinline
              poster="/kafit-store-logo.webp"
            ></video>
          </div>
        </div>

        <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_rgba(255,255,255,0.12),_rgba(0,0,0,0.12)_35%,_rgba(0,0,0,0.72)_100%)]"></div>
        <div class="absolute inset-0 bg-black/45"></div>
      </div>

      <div class="hero-logo-wrap relative z-10 flex w-full flex-col items-center justify-center text-center">
        <img src="/kafit-store-logo.webp" width="2172" height="724" alt="KAfit Store" class="hero-logo-mobile hero-logo-desktop mx-auto w-full max-w-[920px] object-contain drop-shadow-[0_18px_26px_rgba(255,121,35,0.18)] md:max-w-[1180px]" />

        <div class="mt-8 flex flex-col items-center justify-center md:mt-12 mobile-cta-lift">
          <a href="https://www.instagram.com/kafit__store?stkn=MTdlNnl5eHBsYndtZA==" rel="noreferrer" aria-label="Termékek megtekintése az Instagramon" class="instagram-soft-glow inline-flex items-center gap-3 text-white transition duration-300 hover:scale-[1.02]">
            <span class="text-center text-[0.68rem] font-semibold uppercase tracking-[0.22em] text-orange-200/80 md:text-[0.74rem]">
              Termékek megtekintése az Instagramon
            </span>

            <svg viewBox="0 0 24 24" aria-hidden="true" class="h-10 w-10 fill-current md:h-12 md:w-12">
              <path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5Zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7Zm5 3.25A4.75 4.75 0 1 1 7.25 12 4.75 4.75 0 0 1 12 7.25Zm0 2A2.75 2.75 0 1 0 14.75 12 2.75 2.75 0 0 0 12 9.25Zm5.25-3.5a1.25 1.25 0 1 1-1.25 1.25 1.25 1.25 0 0 1 1.25-1.25Z"/>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <section id="rendeles-menete" class="border-t border-white/10 bg-slate-950/60">
      <div class="mx-auto max-w-6xl px-6 py-20">
        <h2 class="text-3xl font-bold text-white md:text-5xl">Rendelés menete:</h2>

        <div class="mt-10 grid gap-6 md:grid-cols-3">
          <div class="rounded-[1.5rem] border border-white/10 bg-white/5 p-6">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-orange-500/15 text-lg font-bold text-orange-300">1.</div>
            <h3 class="text-xl font-semibold text-white">Válassz terméket</h3>
            <p class="mt-3 text-slate-300">Nézd meg a kínálatunkat az Instagram-on, és a kiválasztott terméknek a kódszámát másold ki.</p>
          </div>
          <div class="rounded-[1.5rem] border border-white/10 bg-white/5 p-6">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-orange-500/15 text-lg font-bold text-orange-300">2.</div>
            <h3 class="text-xl font-semibold text-white">Rendelés leadása</h3>
            <p class="mt-3 text-slate-300">Weboldalunkon kattints a vásárlás gombra.</p>
          </div>
          <div class="rounded-[1.5rem] border border-white/10 bg-white/5 p-6">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-orange-500/15 text-lg font-bold text-orange-300">3.</div>
            <h3 class="text-xl font-semibold text-white">Megrendelési adatok kitöltése</h3>
            <p class="mt-3 text-slate-300">Illeszd be a megrendelni kívánt termékek kódját, majd töltsd ki a szállításhoz szükséges adatokat.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="vasarlas" class="border-t border-white/10 bg-slate-950/85">
      <div class="mx-auto max-w-6xl px-6 py-20">
        <div class="mb-10 text-center">
          <p class="text-sm font-medium uppercase tracking-[0.18em] text-orange-300">Vásárlás</p>
          <h2 class="mt-3 text-3xl font-bold text-white md:text-5xl">Küldd el a rendelésed</h2>
        </div>

        <form id="checkout-form" action="https://formspree.io/f/xqparrra" method="POST" novalidate class="rounded-[1.75rem] border border-white/10 bg-slate-900/80 p-6 shadow-xl shadow-slate-950/30 md:p-8">
          <input type="hidden" name="_subject" value="Új rendelés - KAfit Store" />
          <div id="checkout-base-step" class="space-y-6">
            <div class="grid gap-4 md:grid-cols-2">
              <label class="block text-sm font-medium text-slate-200">
                <span class="mb-2 block">Név</span>
                <input id="customer-name" name="customer_name" type="text" required placeholder="Név" class="base-required w-full rounded-2xl border border-white/10 bg-slate-950 px-4 py-3 text-white placeholder:text-slate-500 focus:border-orange-400 focus:outline-none" />
              </label>

              <label class="block text-sm font-medium text-slate-200">
                <span class="mb-2 block">Telefonszám</span>
                <input id="customer-phone" name="customer_phone" type="tel" required inputmode="tel" pattern="[+0-9()\\s-]{7,}" placeholder="+36 20 123 4567" class="base-required w-full rounded-2xl border border-white/10 bg-slate-950 px-4 py-3 text-white placeholder:text-slate-500 focus:border-orange-400 focus:outline-none" />
              </label>

              <label class="block text-sm font-medium text-slate-200 md:col-span-2">
                <span class="mb-2 block">E-mail</span>
                <input id="customer-email" name="email" type="email" required placeholder="email@pelda.hu" class="base-required w-full rounded-2xl border border-white/10 bg-slate-950 px-4 py-3 text-white placeholder:text-slate-500 focus:border-orange-400 focus:outline-none" />
              </label>
            </div>

            <div class="rounded-2xl border border-white/10 bg-slate-950/70 p-4">
              <div class="mb-3 flex items-center justify-between">
                <h3 class="text-xl font-semibold text-white">Szállítási cím</h3>
                <span class="text-[10px] uppercase tracking-[0.2em] text-slate-400">Kötelező</span>
              </div>

              <div class="grid gap-4 md:grid-cols-2">
                <label class="block text-sm font-medium text-slate-200">
                  <span class="mb-2 block">Város</span>
                  <input id="shipping-city" name="shipping_city" type="text" required placeholder="Budapest" class="base-required w-full rounded-2xl border border-white/10 bg-slate-900 px-4 py-3 text-white placeholder:text-slate-500 focus:border-orange-400 focus:outline-none" />
                </label>

                <label class="block text-sm font-medium text-slate-200">
                  <span class="mb-2 block">Irányítószám</span>
                  <input id="shipping-zip" name="shipping_postal_code" type="text" required inputmode="numeric" pattern="[0-9]{4,5}" placeholder="1037" class="base-required w-full rounded-2xl border border-white/10 bg-slate-900 px-4 py-3 text-white placeholder:text-slate-500 focus:border-orange-400 focus:outline-none" />
                </label>

                <label class="block text-sm font-medium text-slate-200 md:col-span-2">
                  <span class="mb-2 block">Utca, házszám</span>
                  <input id="shipping-address" name="shipping_address" type="text" required placeholder="Bécsi út 12." class="base-required w-full rounded-2xl border border-white/10 bg-slate-900 px-4 py-3 text-white placeholder:text-slate-500 focus:border-orange-400 focus:outline-none" />
                </label>
              </div>
            </div>

            <div class="rounded-2xl border border-white/10 bg-slate-950/70 p-4">
              <div class="mb-3 flex items-center justify-between">
                <h3 class="text-xl font-semibold text-white">Termékek kódja</h3>
                <span class="text-[10px] uppercase tracking-[0.2em] text-slate-400">Kötelező</span>
              </div>

              <div id="product-code-list" class="space-y-3"></div>

              <div class="mt-4 flex flex-col gap-3 md:flex-row">
                <input id="product-code-input" type="text" autocomplete="off" pattern="[A-Z0-9-]{3,20}" placeholder="Pl.: KAFIT-204" class="w-full rounded-2xl border border-white/10 bg-slate-900 px-4 py-3 text-white placeholder:text-slate-500 focus:border-orange-400 focus:outline-none" />
                <button type="button" id="add-product-code" class="rounded-full bg-orange-500 px-4 py-3 text-sm font-semibold text-white transition hover:bg-orange-400">
                  Kód bevitele
                </button>
              </div>
            </div>

            <label class="flex items-center gap-3 rounded-2xl border border-white/10 bg-slate-950/70 px-4 py-3 text-sm text-slate-300">
              <input id="billing-toggle" type="checkbox" class="h-4 w-4 rounded border-white/20 bg-slate-900 text-orange-500 focus:ring-orange-400" />
              <span>A számlázási cím eltér a szállítási címtől.</span>
            </label>

            <div id="billing-address" class="hidden rounded-2xl border border-white/10 bg-slate-950/70 p-4">
              <div class="mb-3 flex items-center justify-between">
                <h3 class="text-xl font-semibold text-white">Számlázási cím</h3>
                <span class="text-[10px] uppercase tracking-[0.2em] text-slate-400">Opcionális</span>
              </div>

              <div class="grid gap-4 md:grid-cols-2">
                <label class="block text-sm font-medium text-slate-200">
                  <span class="mb-2 block">Város</span>
                  <input id="billing-city" name="billing_city" type="text" placeholder="Székesfehérvár" class="w-full rounded-2xl border border-white/10 bg-slate-900 px-4 py-3 text-white placeholder:text-slate-500 focus:border-orange-400 focus:outline-none" />
                </label>

                <label class="block text-sm font-medium text-slate-200">
                  <span class="mb-2 block">Irányítószám</span>
                  <input id="billing-zip" name="billing_postal_code" type="text" inputmode="numeric" pattern="[0-9]{4,5}" placeholder="8000" class="w-full rounded-2xl border border-white/10 bg-slate-900 px-4 py-3 text-white placeholder:text-slate-500 focus:border-orange-400 focus:outline-none" />
                </label>

                <label class="block text-sm font-medium text-slate-200 md:col-span-2">
                  <span class="mb-2 block">Utca, házszám</span>
                  <input id="billing-address-line" name="billing_address" type="text" placeholder="Fő utca 25." class="w-full rounded-2xl border border-white/10 bg-slate-900 px-4 py-3 text-white placeholder:text-slate-500 focus:border-orange-400 focus:outline-none" />
                </label>
              </div>
            </div>

            <div class="flex justify-end">
              <button type="button" id="to-summary-button" class="rounded-full bg-orange-500 px-5 py-3 text-sm font-semibold text-white transition hover:bg-orange-400">
                Rendelés összefoglalása
              </button>
            </div>
          </div>

          <div id="checkout-summary-step" class="hidden space-y-6">
            <div class="grid gap-6 lg:grid-cols-[1fr_1.1fr]">
              <div class="rounded-[1.5rem] border border-white/10 bg-slate-950/70 p-6">
                <h3 class="text-xl font-semibold text-white">Alapadatok</h3>
                <div id="summary-base-data" class="mt-4 space-y-3 text-sm text-slate-300"></div>
              </div>

              <div class="rounded-[1.5rem] border border-white/10 bg-slate-950/70 p-6">
                <h3 class="text-xl font-semibold text-white">Termékek</h3>
                <div id="summary-product-list" class="mt-4 space-y-3 text-sm text-slate-300"></div>
              </div>
            </div>

            <div class="rounded-[1.5rem] border border-white/10 bg-slate-950/70 p-6">
              <h3 class="text-xl font-semibold text-white">Fizetési mód</h3>

              <div class="mt-4 grid gap-3 md:grid-cols-2">
                <label class="flex cursor-pointer items-center justify-between rounded-2xl border border-white/10 bg-slate-900/90 px-4 py-3 text-sm font-medium text-white">
                  <span>Utánvét</span>
                  <input type="radio" name="paymentMethod" value="afterpay" checked class="h-4 w-4 accent-orange-500" />
                </label>

                <label class="flex cursor-pointer items-center justify-between rounded-2xl border border-white/10 bg-slate-900/90 px-4 py-3 text-sm font-medium text-white">
                  <span>Előre utalás</span>
                  <input type="radio" name="paymentMethod" value="bank" class="h-4 w-4 accent-orange-500" />
                </label>
              </div>
            </div>

            <label class="flex items-start gap-3 rounded-2xl border border-white/10 bg-slate-950/70 px-4 py-3 text-sm text-slate-300">
              <input id="order-confirmation" name="order_confirmation" value="yes" type="checkbox" required class="mt-1 h-4 w-4 rounded border-white/20 bg-slate-900 text-orange-500 focus:ring-orange-400" />
              <span>Elolvastam és elfogadom, hogy az adatok helyesek, és a megrendelést továbbítani tudom.</span>
            </label>

            <div class="flex flex-wrap gap-3 text-sm text-slate-300">
              <button type="button" data-modal-open="returns" class="rounded-full border border-white/10 bg-white/5 px-3 py-2 text-left transition hover:bg-white/10">Elállási jog</button>
              <button type="button" data-modal-open="privacy" class="rounded-full border border-white/10 bg-white/5 px-3 py-2 text-left transition hover:bg-white/10">Adatkezelés</button>
              <button type="button" data-modal-open="size-guide" class="rounded-full border border-white/10 bg-white/5 px-3 py-2 text-left transition hover:bg-white/10">Mérettáblázat</button>
            </div>

            <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-between">
              <button type="button" id="back-to-base-button" class="rounded-full border border-white/10 bg-white/5 px-5 py-3 text-sm font-semibold text-white transition hover:bg-white/10">
                Vissza az adatokhoz
              </button>

              <button type="submit" class="rounded-full bg-orange-500 px-5 py-3 text-sm font-semibold text-white transition hover:bg-orange-400">
                Megrendelés elküldése
              </button>
            </div>
          </div>
          <p id="checkout-form-status" class="mt-4 min-h-5 text-sm text-slate-300" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>

    <section id="kapcsolat" class="border-t border-white/10 bg-slate-950">
      <div class="mx-auto max-w-4xl px-6 py-20">
        <h2 class="text-center text-3xl font-bold text-white md:text-5xl">Elakadtál? Probléma akadt a rendeléseddel?</h2>

        <form id="contact-form" action="https://formspree.io/f/myezrrqe" method="POST" class="mt-10 rounded-[1.75rem] border border-white/10 bg-white/5 p-6 shadow-xl shadow-slate-950/30 md:p-8">
          <input type="hidden" name="_subject" value="Kapcsolatfelvétel - KAfit Store" />

          <label class="mb-5 block text-sm text-slate-300">
            Név
            <input type="text" name="name" autocomplete="name" required class="mt-2 w-full rounded-xl border border-white/10 bg-slate-900 px-4 py-3 text-white placeholder:text-slate-500 focus:border-orange-400 focus:outline-none" />
          </label>

          <label class="mb-5 block text-sm text-slate-300">
            E-mail-cím
            <input type="email" name="email" autocomplete="email" required class="mt-2 w-full rounded-xl border border-white/10 bg-slate-900 px-4 py-3 text-white placeholder:text-slate-500 focus:border-orange-400 focus:outline-none" />
          </label>

          <label class="block text-sm text-slate-300">
            Üzenet
            <textarea name="message" rows="6" required placeholder="Írd le, miben segíthetünk..." class="mt-2 w-full rounded-2xl border border-white/10 bg-slate-900 px-4 py-3 text-white placeholder:text-slate-500 focus:border-orange-400 focus:outline-none"></textarea>
          </label>

          <label class="mt-5 flex items-start gap-3 text-sm text-slate-300">
            <input type="checkbox" name="details-confirmed" value="yes" required class="mt-1 h-4 w-4 rounded border-white/20 bg-slate-900 text-orange-500 focus:ring-orange-400" />
            <span>Ellenőriztem, hogy az elérhetőségeim és az üzenetem helyesek.</span>
          </label>

          <button type="submit" class="mt-6 w-full rounded-full bg-orange-500 px-5 py-3 text-sm font-semibold text-white transition hover:bg-orange-400 disabled:cursor-not-allowed disabled:opacity-50">
            Küldés
          </button>
          <p id="contact-form-status" class="mt-4 min-h-5 text-sm text-slate-300" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-20">
      <div class="rounded-[2rem] border border-white/10 bg-gradient-to-r from-emerald-500/10 to-cyan-500/10 p-8 md:p-12">
        <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
          <div>
            <p class="text-sm font-medium uppercase tracking-[0.18em] text-emerald-300">Rólunk</p>
            <h2 class="mt-3 text-3xl font-bold text-white md:text-4xl">Több, mint egy webshop.<br />Ez a mi történetünk.</h2>
          </div>
          <a href="/rolunk" class="inline-flex rounded-full border border-emerald-300/40 bg-emerald-400/10 px-5 py-3 text-sm font-semibold text-emerald-200 transition hover:bg-emerald-400/20">
            Bővebben
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-white/10 bg-slate-950">
    <div class="mx-auto grid max-w-6xl gap-8 px-6 py-10 md:grid-cols-[1.1fr_1.3fr]">
      <div class="space-y-4">
        <div class="text-2xl font-black tracking-tight text-white">KAfit-Store</div>
        <p class="max-w-md text-sm leading-6 text-slate-300">Több, mint egy webshop. Ez a mi történetünk.</p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <div class="space-y-3">
          <div class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-400">Navigáció</div>
          <div class="flex flex-col gap-2 text-sm text-slate-300">
            {navItems.map((item) => (
              <a href={item.href} class="transition hover:text-white">{item.label}</a>
            ))}
          </div>
        </div>

        <div class="space-y-3">
          <div class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-400">Információk</div>
          <div class="flex flex-col gap-2 text-sm text-slate-300">
            <button type="button" data-modal-open="returns" class="text-left transition hover:text-white">Elállási jog és visszaküldés</button>
            <button type="button" data-modal-open="privacy" class="text-left transition hover:text-white">Adatkezelési tájékoztató</button>
