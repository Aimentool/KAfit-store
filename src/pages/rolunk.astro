---
import Layout from '../layouts/Layout.astro';

const values = [
  { label: 'Több száz elégedett vásárló', value: '✓' },
  { label: 'Eredeti termékek', value: '✓' },
  { label: 'Sérülésmentes ruhadarabok', value: '✓' },
  { label: 'Kedvező ár!', value: '✓' },
];
---

<Layout title="Rólunk | KAfit Store" description="Ismerd meg a KAfit Store csapatát és az egészségesebb életmód felé vezető szemléletet." lang="hu">
  <header id="site-header" class="sticky top-0 z-50 border-b border-white/10 bg-black/80 backdrop-blur-md transition-transform duration-300">
    <nav class="mx-auto flex max-w-[1500px] items-center gap-3 px-4 py-3 md:px-8 lg:px-12">
      <a href="/" class="flex items-center text-white" aria-label="KAfit Store kezdőlap">
        <img src="/kafit-store-logo.webp" width="2172" height="724" alt="KAfit Store" class="h-7 w-auto object-contain md:h-12 lg:h-16" />
      </a>

      <div class="hidden items-center gap-8 text-sm text-slate-300 md:flex md:flex-1 md:justify-center">
        <a href="/#rendeles-menete" class="transition hover:text-white">Rendelés menete</a>
        <a href="/rolunk" class="transition hover:text-white">Rólunk</a>
        <a href="/#kapcsolat" class="transition hover:text-white">Kapcsolatfelvétel</a>
      </div>

      <div class="flex flex-1 justify-center md:hidden">
        <a href="/#vasarlas" class="nav-cta-2026 inline-flex px-4 py-2.5 text-sm font-semibold text-white">
          Vásárlás
        </a>
      </div>

      <div class="ml-auto flex items-center gap-2 md:gap-3">
        <a href="/#vasarlas" class="nav-cta-2026 hidden px-4 py-2.5 text-sm font-semibold text-white md:inline-flex">
          Vásárlás
        </a>

        <button
          id="mobile-menu-toggle"
          type="button"
          aria-label="Menü"
          aria-expanded="false"
          class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/10 bg-white/5 text-white transition hover:bg-white/10 md:hidden"
        >
          <span class="flex flex-col gap-1.5">
            <span class="mobile-menu-icon-line block h-0.5 w-5 rounded-full bg-white"></span>
            <span class="mobile-menu-icon-line block h-0.5 w-5 rounded-full bg-white"></span>
            <span class="mobile-menu-icon-line block h-0.5 w-5 rounded-full bg-white"></span>
          </span>
        </button>
      </div>
    </nav>

    <div id="mobile-menu" class="hidden border-t border-white/10 bg-black/95 md:hidden">
      <div class="mx-auto flex max-w-[1500px] flex-col px-4 py-4">
        <a href="/#rendeles-menete" class="mobile-nav-link border-b border-white/5 py-3 text-base text-slate-200 last:border-b-0 hover:text-white">Rendelés menete</a>
        <a href="/rolunk" class="mobile-nav-link border-b border-white/5 py-3 text-base text-slate-200 last:border-b-0 hover:text-white">Rólunk</a>
        <a href="/#kapcsolat" class="mobile-nav-link border-b border-white/5 py-3 text-base text-slate-200 last:border-b-0 hover:text-white">Kapcsolatfelvétel</a>
      </div>
    </div>
  </header>

  <main>
    <section class="mx-auto max-w-6xl px-6 py-20">
      <div class="grid gap-10 md:grid-cols-[1.15fr_0.85fr] md:items-center">
        <div>
          <p class="text-sm font-medium uppercase tracking-[0.18em] text-orange-300">Rólunk</p>
          <h1 class="mt-4 text-4xl font-black tracking-tight text-white md:text-6xl">
            Több, mint egy webshop.
            <span class="mt-2 block text-orange-300">Ez a mi történetünk.</span>
          </h1>
        </div>

        <div class="rounded-[2rem] border border-white/10 bg-slate-900/70 p-8 shadow-2xl shadow-orange-500/10">
          <div class="grid gap-4 sm:grid-cols-2">
            {values.map((item) => (
              <div class="rounded-2xl border border-white/10 bg-white/5 p-4 text-center">
                <div class="text-2xl font-bold text-orange-300">{item.value}</div>
                <div class="mt-2 text-sm font-medium text-slate-200">{item.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="border-t border-white/10 bg-slate-950">
      <div class="mx-auto max-w-6xl px-6 py-20">
        <div class="grid gap-8 lg:grid-cols-[1.15fr_0.85fr]">
          <div class="space-y-6 rounded-[2rem] border border-white/10 bg-white/5 p-6 md:p-8">
            <p class="text-lg leading-8 text-slate-300">
              A KAfitStore egy közös ötletből indult.
            </p>

            <p class="text-lg leading-8 text-slate-300">
              Ketten álmodtuk meg, közösen építjük, és minden egyes darabban ott van az, amit mi is fontosnak tartunk: <strong class="font-semibold text-white">minőség, stílus és valódi érték</strong>.
            </p>

            <p class="text-lg leading-8 text-slate-300">
              Nem szeretnénk egyszerűen csak ruhákat és kiegészítőket kínálni. Olyan darabokat válogatunk össze, amelyeket mi magunk is szívesen viselnénk – ikonikus márkákat, friss modelleket és olyan különleges tételeket, amelyeknek helyük van egy igazán jó gardróbban.
            </p>

            <p class="text-lg leading-8 text-slate-300">
              Hiszünk abban, hogy a stílus nem attól lesz jó, hogy mindenből a legdrágábbat választod. Sokkal inkább attól, hogy megtalálod azt a darabot, ami igazán hozzád illik.
            </p>
          </div>

          <div class="flex flex-col gap-6">
            <div class="rounded-[2rem] border border-orange-500/20 bg-orange-500/5 p-6">
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-orange-300">Mi a fontos számunkra</p>
              <p class="mt-4 text-xl leading-8 text-slate-100">
                Tudatos válogatás, minőség, ár-érték arány és olyan kínálat, amelyben mi is örömmel böngésznénk.
              </p>
            </div>

            <div class="rounded-[2rem] border border-white/10 bg-slate-900/80 p-6">
              <p class="text-lg leading-8 text-slate-300">
                A KAfitStore számunkra nem egy arctalan webshop. Minden rendelés mögött valódi emberek vannak, minden kiválasztott termék mögött pedig ott van a saját ízlésünk és figyelmünk.
              </p>
            </div>
          </div>
        </div>

        <div class="mt-10 rounded-[2rem] border border-orange-500/20 bg-gradient-to-r from-orange-500/10 via-slate-900/40 to-white/5 p-8 md:p-10">
          <div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
            <div>
              <p class="text-lg leading-8 text-slate-300">
                Folyamatosan keressük az új darabokat, követjük az aktuális trendeket, de közben az időtálló klasszikusokról sem feledkezünk meg.
              </p>
            </div>

            <div class="text-center lg:text-left">
              <p class="text-sm font-medium uppercase tracking-[0.2em] text-orange-300">A kedvencedet</p>
              <div class="mt-3 flex items-end justify-center gap-2 lg:justify-start">
                <span class="text-5xl font-black leading-none text-white md:text-7xl">Te</span>
                <span class="pb-2 text-2xl font-semibold text-orange-300 md:text-3xl">választod.</span>
              </div>
              <p class="mt-4 text-lg text-slate-200">Mi gondoskodunk a többi részletről.</p>
            </div>
          </div>
        </div>

        <div class="mt-10 text-center">
          <p class="text-2xl font-semibold text-white">Aliz &amp; Kristóf</p>
          <p class="mt-2 text-xl font-bold text-orange-300">KAfitStore</p>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 pb-20">
      <div class="rounded-[2rem] border border-orange-400/20 bg-gradient-to-r from-orange-500/10 to-amber-500/10 p-8 md:p-12">
        <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
          <div>
            <p class="text-sm font-medium uppercase tracking-[0.18em] text-orange-300">Készen állsz?</p>
            <h2 class="mt-3 text-3xl font-bold text-white">Fedezd fel a kínálatunkat.</h2>
          </div>
          <a href="https://www.instagram.com/kafit__store?stkn=MTdlNnl5eHBsYndtZA==" rel="noreferrer" aria-label="Termékek megtekintése az Instagramon" class="instagram-soft-glow inline-flex items-center gap-3 rounded-full border border-orange-300/40 bg-orange-500/10 px-5 py-3 text-sm font-semibold text-white transition duration-300 hover:scale-[1.02]">
            <span class="text-center text-[0.68rem] font-semibold uppercase tracking-[0.22em] text-orange-200/80 md:text-[0.74rem]">
              Termékek megtekintése az Instagramon
            </span>

            <svg viewBox="0 0 24 24" aria-hidden="true" class="h-10 w-10 fill-current md:h-12 md:w-12">
              <path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5Zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7Zm5 3.25A4.75 4.75 0 1 1 7.25 12 4.75 4.75 0 0 1 12 7.25Zm0 2A2.75 2.75 0 1 0 14.75 12 2.75 2.75 0 0 0 12 9.25Zm5.25-3.5a1.25 1.25 0 1 1-1.25 1.25 1.25 1.25 0 0 1 1.25-1.25Z"/>
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-white/10 bg-slate-950">
    <div class="mx-auto flex max-w-6xl flex-col gap-6 px-6 py-8 md:flex-row md:items-center md:justify-between">
      <div>
        <div class="text-lg font-semibold text-white">KAfit Store</div>
        <div class="mt-1 text-sm text-slate-400">Sporteszközök és wellness mindennapokra.</div>
      </div>
      <div class="flex flex-wrap gap-6 text-sm text-slate-300">
        <a href="/#rendeles-menete" class="transition hover:text-white">Rendelés menete</a>
        <a href="/rolunk" class="transition hover:text-white">Rólunk</a>
        <a href="/#kapcsolat" class="transition hover:text-white">Kapcsolatfelvétel</a>
      </div>
    </div>
  </footer>
</Layout>

<script>
  const siteHeader = document.getElementById('site-header');
  const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  if (siteHeader && mobileMenuToggle && mobileMenu) {
    let lastScrollY = window.scrollY;

    const applyHeaderState = () => {
      const isMobile = window.innerWidth < 768;
      const isOpen = !mobileMenu.classList.contains('hidden');

      if (!isMobile) {
        siteHeader.classList.remove('nav-hidden');
        siteHeader.classList.add('nav-visible');
        return;
      }

      if (isOpen) {
        siteHeader.classList.remove('nav-hidden');
        siteHeader.classList.add('nav-visible');
        lastScrollY = window.scrollY;
        return;
      }

      if (window.scrollY > lastScrollY && window.scrollY > 24) {
        siteHeader.classList.add('nav-hidden');
        siteHeader.classList.remove('nav-visible');
      } else {
        siteHeader.classList.remove('nav-hidden');
        siteHeader.classList.add('nav-visible');
      }

      lastScrollY = window.scrollY;
    };

    const lines = mobileMenuToggle.querySelectorAll('.mobile-menu-icon-line');

    const updateMenuIcon = () => {
      const isOpen = !mobileMenu.classList.contains('hidden');
      lines.forEach((line) => line.classList.toggle('open', isOpen));
      mobileMenuToggle.setAttribute('aria-expanded', String(isOpen));
    };

    const toggleMenu = () => {
      mobileMenu.classList.toggle('hidden');
      updateMenuIcon();
      applyHeaderState();
    };

    mobileMenuToggle.addEventListener('click', toggleMenu);
    mobileLinks.forEach((link) => link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      updateMenuIcon();
    }));

    window.addEventListener('scroll', applyHeaderState, { passive: true });
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768) {
        mobileMenu.classList.add('hidden');
        updateMenuIcon();
      }
      applyHeaderState();
    });

    updateMenuIcon();
    applyHeaderState();
  }
</script>
